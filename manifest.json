{
  "manifest_version": 3,
  "name": "Kinlink (dev)",
  "version": "0.18.0",
  "description": "Dev build: a paired peer can fetch URLs through this browser.",
  "action": {
    "default_title": "Open Kinlink"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "offscreen",
    "storage",
    "debugger"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "optional_permissions": [
    "webNavigation"
  ],
  "version_name": "0018"
}
